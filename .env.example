# Copy to .env.local for local dev (gitignored) and set the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.
# See the admin console setup steps for how to obtain each one.

# Auto-injected by Vercel once you connect a Global Config (formerly "Edge
# Config") store to this project from the dashboard — you shouldn't need to
# set this one by hand except for local dev via `vercel env pull .env.local`.
GLOBAL_CONFIG=

# The Global Config store's id ("ecfg_..."), shown on its dashboard page.
# Needed because the SDK only reads — writes go through the Vercel REST API.
GLOBAL_CONFIG_ID=

# A Vercel API token (Account Settings → Tokens) scoped to the team/account
# that owns the Global Config store above. Server-only — never exposed to
# the client.
VERCEL_API_TOKEN=

# Only needed if this project lives under a Vercel Team (not a personal
# account) — the team's id/slug from its settings URL.
VERCEL_TEAM_ID=

# The admin console's passphrase. Generate a real one, e.g.:
#   openssl rand -base64 24
ADMIN_SECRET=
